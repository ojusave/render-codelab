# Local development only. On Render, variables come from the Blueprint / Dashboard.

PORT=8787
DATABASE_URL=postgresql://workshop:workshop@localhost:5432/workshop_codelab

TUTOR_PASSWORD=workshop
SESSION_SIGNING_SECRET=dev-insecure-secret

# Baked into the client at build time (set in render.yaml on Render).
VITE_GITHUB_REPO_URL=https://github.com/ojusave/render-codelab
VITE_DEFAULT_SESSION_CODE=cascadia-2026
SEED_SESSION_CODE=cascadia-2026
